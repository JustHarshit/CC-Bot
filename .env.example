# ============================================
# Content Creation Chatbot - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your API key

# Option 1: OpenAI (Recommended)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Option 3: Groq (Fastest, Free tier available)
# GROQ_API_KEY=gsk_your-groq-api-key-here

# Model Selection (optional - defaults to gpt-4o-mini)
# NEXT_PUBLIC_AI_MODEL=gpt-4o-mini

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
